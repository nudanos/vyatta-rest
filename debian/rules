#!/usr/bin/make -f
# -*- makefile -*-

# see EXAMPLES in dpkg-buildflags(1) and read /usr/share/dpkg/*
DPKG_EXPORT_BUILDFLAGS = 1
export DEB_BUILD_HARDENING=1
include /usr/share/dpkg/default.mk

%:
	dh $@ --with autoreconf --with config_package --with yang

override_dh_auto_configure:
	dh_auto_configure -- --prefix=/opt/vyatta

override_dh_auto_install:
	dh_auto_install -- DESTDIR=$(CURDIR)/debian/vyatta-rest

# lighttpd TLS: the dependency and the module load travel with ssl.engine;
# the FastCGI socket must be outside lighttpd.service's private /tmp
override_dh_auto_test:
	dh_auto_test
	sh tests/openssl-consistent.sh
	sh tests/fcgi-socket-consistent.sh

override_dh_fixperms:
	chmod --reference /etc/cron.daily/lighttpd \
		$(CURDIR)/debian/vyatta-rest/etc/cron.daily/lighttpd.vyatta
	dh_fixperms

# Started on demand by configd, as the init script was; never at boot.
override_dh_installsystemd:
	dh_installsystemd --name=vyatta-webgui-chunker-aux --no-enable --no-start
