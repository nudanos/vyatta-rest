#!/bin/sh
set -e
case "$1" in
    remove|purge)
        # written or edited into lighttpd's conf-enabled by postinst
        rm -f /etc/lighttpd/conf-enabled/10-cgi.conf \
              /etc/lighttpd/conf-enabled/10-ssl.conf \
              /etc/lighttpd/conf-enabled/10-fastcgi.conf
        # the TLS module load postinst appended to lighttpd.conf
        if [ -f /etc/lighttpd/lighttpd.conf ]; then
            sed -i '/^server.modules += ( "mod_openssl" )$/d' /etc/lighttpd/lighttpd.conf
        fi
        ;;
esac
#DEBHELPER#
exit 0
